{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "LogStorage": {
    "RootPath": "logs",
    "Interval": "00:15:00",
    "InitialDelay": "00:00:10",
    "CompressionLevel": 3,
    "ArchiveAfterDays": 2,
    "SegmentRetentionDays": 0,
    "ArchiveRetentionDays": 1825,
    "Reindex": true,
    "Verify": false
  }
}
