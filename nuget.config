<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Config propia del repo: todos los paquetes vienen de nuget.org.
    Se limpian los orígenes heredados para que el "package source mapping" de la
    máquina no bloquee la restauración.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <clear />
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
