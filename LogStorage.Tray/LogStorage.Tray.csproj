<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      Sobrescribe el TargetFramework de Directory.Build.props: Windows Forms necesita el
      TFM con sufijo de plataforma. El resto de la solución sigue en net10.0 y multiplataforma.
    -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>LogStorage.Tray</RootNamespace>
    <AssemblyName>LogStorage.Tray</AssemblyName>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>

    <!-- Un panel que vive en la bandeja no quiere el GC de servidor que hereda de Directory.Build.props. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>

    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationVisualStyles>true</ApplicationVisualStyles>
    <ApplicationUseCompatibleTextRendering>false</ApplicationUseCompatibleTextRendering>
    <ApplicationDefaultFont>Segoe UI, 9pt</ApplicationDefaultFont>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.ServiceProcess.ServiceController" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LogStorage.Core\LogStorage.Core.csproj" />
  </ItemGroup>

</Project>
